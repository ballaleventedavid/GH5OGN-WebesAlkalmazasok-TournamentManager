# Node.js 24.15+; az alkalmazás automatikusan beolvassa a .env fájlt.
PORT=3000
HOST=127.0.0.1
DATABASE_PATH=./data/tournament-megyei.sqlite
# true: az első induláskor bemutatóadatok és ismert demójelszavak készülnek.
# Saját telepítéshez: false és INITIAL_ADMIN_EMAIL / INITIAL_ADMIN_PASSWORD.
SEED_DEMO=true
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=
INITIAL_ADMIN_NAME=Szervező
APP_ORIGIN=http://localhost:3000
# A feladófiók szerveroldali beállításai; a felületen csak a címzett látszik.
# A meglévő data/mail-settings.json elsőbbséget élvez; frissítéskor őrizd meg.
MAIL_MODE=preview
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_REQUIRE_TLS=true
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
# Külső HTTPS telepítésnél: true. HTTPS szükséges a Secure cookie-hoz.
COOKIE_SECURE=false
